// Nodedr OrderRestro — Phase 0/1 core schema.
// See ARCHITECTURE.md for why PostgreSQL is the primary target and how
// multi-branch/single-location both map onto the same schema (a branch is
// just a Branch row, not a different deployment mode).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy / Branch
// ---------------------------------------------------------------------------

// A branch's tax regime picks sensible defaults (display label, whether the
// receipt splits into CGST/SGST, and the usual INCLUSIVE/EXCLUSIVE mode) —
// see taxRegimes.ts. CUSTOM means every one of those is taken from the
// branch's own taxLabel/taxMode instead of the preset.
enum TaxRegime {
  INDIA_GST
  US_SALES_TAX
  EU_VAT
  ES_IVA
  CUSTOM
}

// Whether MenuItem.price already has tax baked in (the nodedr-pos GST
// lesson — India/EU/Spain all display tax-inclusive menu prices by
// convention/regulation) or is a pre-tax price the checkout adds tax on
// top of (the US norm). See pricing.ts's toEffectiveInclusiveUnitPrice —
// this is the ONLY place the mode changes the pricing math; everything
// downstream of that (OrderItem.lineTotal, receipts, refunds) keeps
// working off an already-inclusive amount exactly as before.
enum TaxMode {
  INCLUSIVE
  EXCLUSIVE
}

model Restaurant {
  id        String  @id @default(cuid())
  name      String
  legalName String?
  // The restaurant's own branding, shown in the app shell (sidebar header,
  // login screen) in place of the Nodedr OrderRestro product mark — this is
  // white-label self-hosted software, so the operator's brand should lead;
  // the product name stays as a small credit line instead (see BrandFooter).
  logoUrl   String?
  brandColor String @default("#0066CC")
  fontFamily String @default("system")
  websiteHeadline String?
  heroImageUrl String?
  currency  String  @default("INR")
  timezone  String  @default("Asia/Kolkata")

  // UPI payee for the dynamic QR shown at checkout and on the customer
  // display (NPCI deep link, see apps/web/lib/upi.ts). Optional: when unset
  // the UPI method still works, it just shows no QR.
  upiVpa       String?
  upiPayeeName String?

  // Loyalty program config — previously hardcoded constants in
  // OrdersService, now per-restaurant and settings-editable. Point value
  // is the currency amount 1 redeemed point is worth; earn rate is how
  // many currency units of net spend earn 1 point (floor division).
  loyaltyPointValue      Decimal @default(1) @db.Decimal(6, 2)
  loyaltyEarnPerCurrency Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches           Branch[]
  roles              Role[]
  users              User[]
  integrationApiKeys IntegrationApiKey[]
  webhookEndpoints   WebhookEndpoint[]

  @@map("restaurants")
}

model Branch {
  customerPortalEnabled Boolean @default(false)
  id               String            @id @default(cuid())
  restaurantId     String
  restaurant       Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  attendance       Attendance[]
  deliveryZones    DeliveryZone[]
  shifts           Shift[]
  leaveRequests    LeaveRequest[]
  payrollRuns      PayrollRun[]
  expenses         Expense[]
  budgets          Budget[]
  bankTransactions BankTransaction[]
  reportSchedules  ReportSchedule[]
  cashClosings     CashClosing[]
  coupons          Coupon[]
  promotions       Promotion[]
  campaigns        Campaign[]
  equipment        Equipment[]
  documents        Document[]

  name      String
  address   String?
  phone     String?
  gstNumber String?

  // Multi-region tax config (2026-09-27). country is an ISO 3166-1 alpha-2
  // code driving default currency/locale suggestions in the UI; it does not
  // itself change pricing math. taxRegime picks the preset (label, mode,
  // CGST/SGST split) from taxRegimes.ts; taxMode/taxLabel/taxId override
  // that preset when set (taxMode is always non-null — it defaults to the
  // regime's own default and is what pricing.ts actually reads). taxId is
  // the generic registration number (VAT No. / EIN / NIF-CIF); gstNumber
  // is kept as the India-specific field pre-existing installs already
  // populated and remains the fallback when taxRegime is INDIA_GST and
  // taxId is empty.
  country   String    @default("IN")
  taxRegime TaxRegime @default(INDIA_GST)
  taxMode   TaxMode   @default(INCLUSIVE)
  taxLabel  String?
  taxId     String?

  // Online order / table-booking handling: false = staff must accept each
  // one from the dashboard; true = accepted automatically on arrival.
  autoConfirmOrders       Boolean @default(false)
  autoConfirmReservations Boolean @default(false)

  // Self-service kiosk (2026-10-17). kioskToken is the opaque, unguessable
  // credential in the public /kiosk/<token> URL (same idea as
  // Table.qrToken); null = kiosk switched off for this branch. The two
  // flags choose which "eat here / take away" buttons the start screen
  // offers; if only one is on the choice step is skipped.
  kioskToken           String? @unique
  kioskDineInEnabled   Boolean @default(true)
  kioskTakeawayEnabled Boolean @default(true)

  // Direct ESC/POS thermal printing. Columns null = derived from paper width
  // (58 mm -> 32, 80 mm -> 48); set it for printers with a narrower head.
  printerPaperWidthMm Int     @default(80)
  printerCodepage     String  @default("CP858")
  printerColumns      Int?
  // "USB" = printer attached to the machine running the backend; "NETWORK" =
  // raw ESC/POS over TCP to printerHost:printerPort (usually 9100).
  printerConnection   String  @default("USB")
  printerHost         String?
  printerPort         Int     @default(9100)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  floors          Floor[]
  users           UserBranch[]
  menuItems       MenuItem[]
  categories      MenuCategory[]
  modifierGroups  ModifierGroup[]
  stations        KitchenStation[]
  orders          Order[]
  customers       Customer[]
  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]
  giftCards       GiftCard[]
  ingredients     Ingredient[]
  suppliers       Supplier[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  stockBatches    StockBatch[]
  stockMovements  StockMovement[]
  wasteLogs       WasteLog[]

  purchaseRequests   PurchaseRequest[]
  supplierQuotations SupplierQuotation[]
  supplierInvoices   SupplierInvoice[]
  supplierPayments   SupplierPayment[]
  notifications      Notification[]
  integrationApiKeys IntegrationApiKey[]

  @@index([restaurantId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Auth / RBAC
// ---------------------------------------------------------------------------

// The fixed 11-role template used only at seed/signup time to bootstrap a
// new restaurant's default roles now lives as `STAFF_ROLES` in
// packages/types/src/permissions.ts (TS const array), not here. `Role.name`
// below is a plain String — an Owner can create custom roles with any name
// beyond that seeded set (e.g. "Display", "Host", "Valet").

model Permission {
  id       String @id @default(cuid())
  key      String @unique // e.g. "orders.create", "menu.manage"
  label    String
  category String // grouping for the settings UI, e.g. "Orders", "Inventory"

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name      String
  label     String
  isSystem  Boolean  @default(true) // seeded default role vs. custom role
  createdAt DateTime @default(now())

  permissions RolePermission[]
  users       User[]

  @@unique([restaurantId, name])
  @@map("roles")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  name                    String
  email                   String?
  phone                   String?
  passwordHash            String
  pinHash                 String? // quick-switch PIN login on a shared terminal
  isActive                Boolean  @default(true)
  twoFactorSecret         String? // AES-GCM sealed TOTP secret (see auth/totp.ts)
  twoFactorEnabled        Boolean  @default(false)
  twoFactorRecoveryHashes String[] @default([]) // bcrypt hashes of unused one-time recovery codes
  twoFactorLastStep       Int? // last accepted TOTP step: a code works once

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches      UserBranch[]
  waiterTables  Table[]        @relation("TableWaiter")
  ordersCreated Order[]        @relation("OrderCreatedBy")
  auditLogs     AuditLog[]
  refundsIssued Refund[]
  notifications Notification[] @relation("NotificationRecipient")

  purchaseOrdersCreated PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  goodsReceiptsReceived GoodsReceipt[]  @relation("GoodsReceiptReceivedBy")
  stockMovementsCreated StockMovement[] @relation("StockMovementCreatedBy")
  wasteLogsCreated      WasteLog[]      @relation("WasteLogCreatedBy")
  attendance            Attendance[]
  deliveriesDriven      Order[]         @relation("OrderDriver")
  shifts                Shift[]
  leaveRequests         LeaveRequest[]  @relation("LeaveRequester")
  leaveDecided          LeaveRequest[]  @relation("LeaveDecider")
  payProfile            StaffPay?
  payrollLines          PayrollLine[]
  expensesCreated       Expense[]

  purchaseRequestsRequested PurchaseRequest[]   @relation("PurchaseRequestRequestedBy")
  purchaseRequestsApproved  PurchaseRequest[]   @relation("PurchaseRequestApprovedBy")
  supplierQuotationsCreated SupplierQuotation[] @relation("SupplierQuotationCreatedBy")
  supplierInvoicesRecorded  SupplierInvoice[]   @relation("SupplierInvoiceRecordedBy")
  supplierPaymentsRecorded  SupplierPayment[]   @relation("SupplierPaymentRecordedBy")

  backupsTriggered Backup[] @relation("BackupTriggeredBy")

  staffApiKeys              StaffApiKey[]
  integrationApiKeysCreated IntegrationApiKey[] @relation("IntegrationApiKeyCreatedBy")

  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// API keys — two distinct kinds, deliberately not one model. See
// docs/integrations-api.md for the full design rationale.
// ---------------------------------------------------------------------------

// A personal access token: resolves to its owning User exactly like a
// logged-in session would, so every existing permission check (PermissionsGuard,
// user.permissions) applies unchanged. Used by the MCP server (see src/mcp/)
// and any other programmatic client acting as that staff member.
model StaffApiKey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  tokenHash  String    @unique
  lastFour   String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("staff_api_keys")
}

// A restaurant-issued credential for an EXTERNAL system (a partner
// website's own backend, an aggregator, a booking widget) — not tied to any
// staff member's identity or permissions. Carries its own explicit `scopes`
// and can be scoped to a single branch ("selected location") or the whole
// restaurant. Consumed by src/integrations/'s public REST API.
model IntegrationApiKey {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name      String
  tokenHash String   @unique
  lastFour  String
  scopes    String[]

  createdById String
  createdBy   User   @relation("IntegrationApiKeyCreatedBy", fields: [createdById], references: [id])

  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([restaurantId])
  @@index([branchId])
  @@map("integration_api_keys")
}

model UserBranch {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}

// In-app notifications (Phase 3 of the RBAC/audit/backup plan) — bell icon +
// sound/haptic in the dashboard topbar. Scoped by `branchId` only, not a
// denormalized `restaurantId`, matching the rest of the schema's convention
// (Order/Table/etc. derive restaurant via branch.restaurant rather than
// storing both). `recipientUserId` is nullable in the model (room for a
// future branch-wide broadcast row), but every current call site
// (NotificationsService.notifyByPermission/notifyUser) always creates one
// row per resolved recipient. `type` is free-form like AuditLog.action
// (e.g. "order.new", "order.ready") — not an enum, so new trigger types
// never need a migration.
model Notification {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  recipientUserId String?
  recipient       User?   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  type     String
  title    String
  body     String
  entity   String?
  entityId String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([branchId, recipientUserId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Backup / restore (Phase 4 of the RBAC/audit/backup plan)
//
// Both models are deliberately instance-wide — no restaurantId/branchId —
// because a `pg_dump` of the shared Postgres instance covers every
// Restaurant row on this server, not one tenant, and the uploads directory
// (see UPLOADS_DIR / common/upload/image-upload.config.ts's `uploadsDir()`)
// is likewise a single shared volume. Ported from zulivio's proven
// BackupRecord/BackupConfig design (apps/backend/src/backup/) — see
// backup.service.ts for the full restore-safety reasoning.
// ---------------------------------------------------------------------------

enum BackupStatus {
  PENDING
  VERIFIED
  FAILED
}

model Backup {
  id     String       @id @default(cuid())
  status BackupStatus @default(PENDING)

  // Int, not BigInt: BigInt doesn't JSON-serialize without extra plumbing
  // (JSON.stringify throws on it), and every real deployment target here
  // (self-hosted restaurant DB + uploads dir) stays well under 2GB. Revisit
  // if a real deployment's dump ever approaches that ceiling.
  sizeBytes    Int?
  s3KeyDb      String?
  s3KeyUploads String?
  sha256       String?

  // Null for scheduled/cron-triggered runs (see backup.service.ts's
  // @Cron job) — only manual triggers have an actor.
  triggeredById String?
  triggeredBy   User?   @relation("BackupTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  failureReason String?
  createdAt     DateTime  @default(now())
  verifiedAt    DateTime?

  @@index([status, createdAt])
  @@map("backups")
}

// Singleton row (id is always the literal "singleton") holding S3 backup
// credentials entered from Settings > Backup, so the app is self-contained
// without requiring env-var/CasaOS config editing. Plaintext at rest — same
// trust boundary as DATABASE_URL/JWT_SECRET already sitting in this app's
// env — and never returned by the API after being set (masked in reads).
model BackupConfig {
  id              String   @id @default("singleton")
  endpoint        String
  bucket          String
  accessKeyId     String
  secretAccessKey String
  region          String   @default("auto")
  intervalDays    Int      @default(3)
  retainCount     Int      @default(2)
  updatedById     String?
  updatedAt       DateTime @updatedAt

  @@map("backup_config")
}

// ---------------------------------------------------------------------------
// Floor & Table management
// ---------------------------------------------------------------------------

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  OUT_OF_SERVICE
}

model Floor {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int    @default(0)

  tables Table[]

  @@index([branchId])
  @@map("floors")
}

model Table {
  id      String @id @default(cuid())
  floorId String
  floor   Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)

  number      String
  name        String?
  capacity    Int         @default(2)
  status      TableStatus @default(AVAILABLE)
  // When `status` last changed — set automatically by a Prisma middleware
  // (see PrismaService) on every write that includes a `status` field, not
  // hand-maintained per call site (status changes from many places: table
  // status dropdown, order creation/checkout, reservation arrival/cancel,
  // waitlist seating). Powers the "how long has this table been occupied/
  // reserved" timer on the floor view and POS table picker.
  statusSince DateTime    @default(now())

  // Floor designer layout — percentage-based so any canvas size renders consistently
  posX     Float   @default(0)
  posY     Float   @default(0)
  width    Float   @default(80)
  height   Float   @default(80)
  rotation Float   @default(0)
  shape    String  @default("square") // square | round | rect
  color    String?

  assignedWaiterId String?
  assignedWaiter   User?   @relation("TableWaiter", fields: [assignedWaiterId], references: [id], onDelete: SetNull)

  notes   String?
  qrToken String? @unique // opaque token embedded in the table's QR code (Phase 2+)

  orders          Order[]
  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests TableRequest[]

  @@unique([floorId, number])
  @@index([floorId])
  @@map("tables")
}

// ---------------------------------------------------------------------------
// Menu management
// ---------------------------------------------------------------------------

model MenuCategory {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name          String
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)
  // false = still on the POS, but hidden from the QR/online ordering page and
  // from the Integration API that feeds the restaurant's own website.
  showOnWebsite Boolean @default(true)

  items MenuItem[]

  @@index([branchId])
  @@map("menu_categories")
}

model KitchenStation {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name        String // e.g. "Main Kitchen", "Tandoor", "Bar", "Dessert Station"
  printerName String?

  items MenuItem[]
  kots  Kot[]

  @@index([branchId])
  @@map("kitchen_stations")
}

enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
  EXTRA_HOT
}

// ---------------------------------------------------------------------------
// Inventory & Store Management (Phase 4)
//
// Deliberate scope-cut vs. the full spec ("units + unit conversion"): each
// Ingredient has ONE base unit, used consistently for its recipe quantities,
// PO/GRN quantities, and stock. A real conversion engine (buy a 25kg bag,
// stock/recipe in kg) is deferred — see ROADMAP.md — rather than guessed at.
//
// Costing is weighted-average (WAC), recomputed on every GRN receipt:
// newCost = ((oldStock * oldCost) + (receivedQty * receivedCost)) /
// (oldStock + receivedQty). Ingredient.currentStock/costPerUnit are cached
// columns, but NEVER mutated with a DB `increment` — same float-drift lesson
// nodedr-pos learned the hard way (see its project memory): every mutation
// reads the current value, computes the new one in JS with round4, and
// `set`s it inside the same transaction as the StockMovement ledger row.
// StockMovement is the append-only source of truth; the cached columns are
// a read optimization that must always be derivable by summing it.
// ---------------------------------------------------------------------------

enum IngredientUnit {
  KG
  G
  L
  ML
  PIECE
  DOZEN
  PACK
  BOX
}

model Ingredient {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name         String
  sku          String?
  unit         IngredientUnit
  reorderLevel Decimal        @default(0) @db.Decimal(12, 3)

  // Cached from the StockMovement ledger — see note above on why these are
  // safe (transactional read-then-set, never `increment`).
  currentStock Decimal @default(0) @db.Decimal(12, 3)
  costPerUnit  Decimal @default(0) @db.Decimal(12, 4) // weighted-average cost

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipeLines        RecipeIngredient[]
  directMenuItems    MenuItem[]          @relation("DirectStockItem")
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  stockBatches       StockBatch[]
  stockMovements     StockMovement[]
  wasteLogs          WasteLog[]

  purchaseRequestItems   PurchaseRequestItem[]
  supplierQuotationItems SupplierQuotationItem[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("ingredients")
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  quantity  Decimal  @db.Decimal(12, 3) // in ingredient.unit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([menuItemId, ingredientId])
  @@index([menuItemId])
  @@map("recipe_ingredients")
}

model Supplier {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  gstNumber   String?
  notes       String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  quotations SupplierQuotation[]
  invoices   SupplierInvoice[]

  @@index([branchId])
  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  poNumber     String
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  notes        String?
  totalAmount  Decimal             @default(0) @db.Decimal(12, 2)

  createdById String
  createdBy   User     @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  invoices      SupplierInvoice[]

  @@unique([branchId, poNumber])
  @@index([branchId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  quantityOrdered  Decimal @db.Decimal(12, 3)
  unitCost         Decimal @db.Decimal(12, 4)
  quantityReceived Decimal @default(0) @db.Decimal(12, 3)

  goodsReceiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  grnNumber String
  notes     String?

  receivedById String
  receivedBy   User     @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id])
  receivedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  items    GoodsReceiptItem[]
  invoices SupplierInvoice[]

  @@unique([branchId, grnNumber])
  @@index([branchId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String       @id @default(cuid())
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  ingredientId   String
  ingredient     Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)

  quantity    Decimal   @db.Decimal(12, 3)
  unitCost    Decimal   @db.Decimal(12, 4)
  batchNumber String
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())

  stockBatch StockBatch?

  @@index([goodsReceiptId])
  @@map("goods_receipt_items")
}

// ---------------------------------------------------------------------------
// Procurement depth — purchase requests, supplier quotations, vendor invoices
// ---------------------------------------------------------------------------

enum PurchaseRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CONVERTED
}

model PurchaseRequest {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  requestNumber String
  status        PurchaseRequestStatus @default(DRAFT)
  notes         String?

  requestedById String
  requestedBy   User    @relation("PurchaseRequestRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?   @relation("PurchaseRequestApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PurchaseRequestItem[]

  @@unique([branchId, requestNumber])
  @@index([branchId, status])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  ingredientId      String
  ingredient        Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  quantityRequested Decimal @db.Decimal(12, 3)
  notes             String?

  @@index([purchaseRequestId])
  @@map("purchase_request_items")
}

enum QuotationStatus {
  DRAFT
  RECEIVED
  ACCEPTED
  REJECTED
}

model SupplierQuotation {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  quotationNumber String
  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime?
  notes           String?

  createdById String
  createdBy   User     @relation("SupplierQuotationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items SupplierQuotationItem[]

  @@unique([branchId, quotationNumber])
  @@index([branchId, supplierId])
  @@map("supplier_quotations")
}

model SupplierQuotationItem {
  id                  String            @id @default(cuid())
  supplierQuotationId String
  supplierQuotation   SupplierQuotation @relation(fields: [supplierQuotationId], references: [id], onDelete: Cascade)
  ingredientId        String
  ingredient          Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  quantityQuoted Decimal @db.Decimal(12, 3)
  unitPrice      Decimal @db.Decimal(12, 4)

  @@index([supplierQuotationId])
  @@map("supplier_quotation_items")
}

enum SupplierInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model SupplierInvoice {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceiptId  String?
  goodsReceipt    GoodsReceipt?  @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)

  invoiceNumber String
  invoiceDate   DateTime
  dueDate       DateTime?
  totalAmount   Decimal               @db.Decimal(12, 2)
  amountPaid    Decimal               @default(0) @db.Decimal(12, 2)
  status        SupplierInvoiceStatus @default(UNPAID)
  notes         String?

  recordedById String
  recordedBy   User     @relation("SupplierInvoiceRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments SupplierPayment[]

  @@unique([branchId, invoiceNumber])
  @@index([branchId, supplierId, status])
  @@map("supplier_invoices")
}

model SupplierPayment {
  id                String          @id @default(cuid())
  branchId          String
  branch            Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplierInvoiceId String
  supplierInvoice   SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)

  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  reference     String?
  paidAt        DateTime      @default(now())

  recordedById String
  recordedBy   User     @relation("SupplierPaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([branchId, supplierInvoiceId])
  @@map("supplier_payments")
}

model StockBatch {
  id           String     @id @default(cuid())
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  goodsReceiptItemId String?           @unique
  goodsReceiptItem   GoodsReceiptItem? @relation(fields: [goodsReceiptItemId], references: [id], onDelete: SetNull)

  batchNumber       String
  quantityReceived  Decimal   @db.Decimal(12, 3)
  quantityRemaining Decimal   @db.Decimal(12, 3)
  unitCost          Decimal   @db.Decimal(12, 4)
  expiryDate        DateTime?
  receivedAt        DateTime  @default(now())

  stockMovements StockMovement[]
  wasteLogs      WasteLog[]

  @@index([branchId, ingredientId, receivedAt])
  @@map("stock_batches")
}

enum StockMovementType {
  RECEIPT
  WASTE
  ADJUSTMENT
  CONSUMPTION
  REVERSAL // compensating +qty when sold items are physically returned
}

// How selling a menu item moves inventory.
//   NONE   - not stock-tracked; selling it never touches inventory.
//   RECIPE - deducts its RecipeIngredient lines per unit sold.
//   DIRECT - deducts stockQuantityPerSale of one stock item (stockIngredientId)
//            per unit sold, e.g. bottled drinks sold as-is; no fake recipe.
enum InventoryTracking {
  NONE
  RECIPE
  DIRECT
}

model StockMovement {
  id           String      @id @default(cuid())
  branchId     String
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  batchId      String?
  batch        StockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  type     StockMovementType
  quantity Decimal           @db.Decimal(12, 3) // signed: +in, -out
  note     String?
  // Set for order-driven movements (checkout consumption / return reversal).
  // Plain column, no FK: the ledger must outlive a deleted order.
  orderId  String?

  createdById String
  createdBy   User     @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([branchId, ingredientId, createdAt])
  @@index([orderId])
  @@map("stock_movements")
}

enum WasteReason {
  EXPIRED
  SPOILED
  DAMAGED
  PREP_ERROR
  OVER_PRODUCTION
  OTHER
}

model WasteLog {
  id           String      @id @default(cuid())
  branchId     String
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  batchId      String?
  batch        StockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  quantity        Decimal     @db.Decimal(12, 3)
  reason          WasteReason
  unitCostAtWaste Decimal     @db.Decimal(12, 4)
  notes           String?

  createdById String
  createdBy   User     @relation("WasteLogCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([branchId, ingredientId, createdAt])
  @@map("waste_logs")
}

model MenuItem {
  id         String          @id @default(cuid())
  branchId   String
  branch     Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  categoryId String
  category   MenuCategory    @relation(fields: [categoryId], references: [id])
  stationId  String?
  station    KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  name        String
  sku         String?
  description String?
  imageUrl    String?

  price          Decimal  @db.Decimal(12, 2) // tax-inclusive selling price (see nodedr-pos GST lesson in ARCHITECTURE.md)
  taxRatePercent Decimal  @default(0) @db.Decimal(5, 2)
  costPrice      Decimal? @db.Decimal(12, 2)

  prepTimeMinutes Int?
  calories        Int?
  isVeg           Boolean    @default(true)
  isVegan         Boolean    @default(false)
  isJain          Boolean    @default(false)
  isHalal         Boolean    @default(false)
  isGlutenFree    Boolean    @default(false)
  spiceLevel      SpiceLevel @default(NONE)
  allergens       String[]   @default([])

  availableFrom String? // "HH:mm" — availability window
  availableTo   String?
  isSeasonal    Boolean   @default(false)
  seasonStart   DateTime?
  seasonEnd     DateTime?

  barcode  String?
  isActive Boolean @default(true)
  isCombo  Boolean @default(false)

  inventoryTracking    InventoryTracking @default(NONE)
  stockIngredientId    String?
  stockIngredient      Ingredient?       @relation("DirectStockItem", fields: [stockIngredientId], references: [id], onDelete: SetNull)
  stockQuantityPerSale Decimal           @default(1) @db.Decimal(12, 3)

  // Price of a half portion; null = item has no portion picker. `price` is the full portion.
  halfPrice Decimal? @db.Decimal(12, 2)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modifierGroups  MenuItemModifierGroup[]
  orderItems      OrderItem[]
  comboComponents ComboComponent[]        @relation("ComboParent")
  usedInCombos    ComboComponent[]        @relation("ComboChild")
  recipeLines     RecipeIngredient[]

  @@index([branchId, categoryId])
  @@map("menu_items")
}

model ModifierGroup {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name       String // e.g. "Crust Type", "Extras"
  minSelect  Int     @default(0)
  maxSelect  Int     @default(1)
  isRequired Boolean @default(false)

  modifiers Modifier[]
  menuItems MenuItemModifierGroup[]

  @@index([branchId])
  @@map("modifier_groups")
}

model Modifier {
  id      String        @id @default(cuid())
  groupId String
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name            String // e.g. "Extra Cheese", "No Onion"
  priceAdjustment Decimal  @default(0) @db.Decimal(12, 2)
  taxRatePercent  Decimal? @db.Decimal(5, 2)
  kitchenNote     String?
  isDefault       Boolean  @default(false)
  sortOrder       Int      @default(0)

  orderItemModifiers OrderItemModifier[]

  @@index([groupId])
  @@map("modifiers")
}

model MenuItemModifierGroup {
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  sortOrder       Int           @default(0)

  @@id([menuItemId, modifierGroupId])
  @@map("menu_item_modifier_groups")
}

// ---------------------------------------------------------------------------
// Customers (minimal Phase 1 shape — full CRM lands Phase 3)
// ---------------------------------------------------------------------------

model Customer {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name        String?
  phone       String?
  email       String?
  address     String?
  birthday    DateTime?
  anniversary DateTime?
  allergies   String?
  notes       String?

  loyaltyPoints   Int     @default(0)
  // Opted out of marketing messages; excluded from every campaign audience.
  marketingOptOut Boolean @default(false)
  walletBalance   Decimal @default(0) @db.Decimal(12, 2) // store credit

  createdAt DateTime   @default(now())
  orders    Order[]
  account   CustomerAccount?
  reservations Reservation[]
  giftCards GiftCard[]

  @@index([branchId, phone])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Gift cards & combos (Phase 3)
// ---------------------------------------------------------------------------

model GiftCard {
  id           String    @id @default(cuid())
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  code         String    @unique
  initialValue Decimal   @db.Decimal(12, 2)
  balance      Decimal   @db.Decimal(12, 2)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  redemptions GiftCardRedemption[]

  @@index([branchId])
  @@map("gift_cards")
}

model GiftCardRedemption {
  id         String   @id @default(cuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@map("gift_card_redemptions")
}

model ComboComponent {
  id              String   @id @default(cuid())
  comboItemId     String
  comboItem       MenuItem @relation("ComboParent", fields: [comboItemId], references: [id], onDelete: Cascade)
  componentItemId String
  componentItem   MenuItem @relation("ComboChild", fields: [componentItemId], references: [id])
  quantity        Int      @default(1)

  @@unique([comboItemId, componentItemId])
  @@map("combo_components")
}

// ---------------------------------------------------------------------------
// Orders / KOT / Payments
// ---------------------------------------------------------------------------

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  DRIVE_THRU
  QR_ORDER
  KIOSK
  PHONE
}

enum OrderStatus {
  OPEN
  BILLED
  PAID
  CANCELLED
}

// Where an order/reservation came from: staff at the POS/phone (STAFF) or a
// guest through the website / QR (ONLINE). Drives the Online vs Offline
// split in the dashboard. Separate from OrderType (dine-in/takeaway/...),
// which says how it is fulfilled.
enum OrderChannel {
  STAFF
  ONLINE
}

// Accept/reject gate for online orders. NOT_REQUIRED = staff-entered or
// auto-confirmed-by-QR orders that never wait; PENDING = waiting for staff to
// accept (no kitchen ticket is printed yet); ACCEPTED/REJECTED = decided.
// Why an order ended up CANCELLED, so a kitchen rejection or a declined online
// order is never confused with staff or the guest withdrawing it.
enum CancelSource {
  STAFF
  CUSTOMER
  KITCHEN_REJECTED
  ONLINE_DECLINED
}

// How the manual discount on a bill was entered.
enum ManualDiscountType {
  PERCENT
  FIXED
}

enum AcceptanceStatus {
  NOT_REQUIRED
  PENDING
  ACCEPTED
  REJECTED
}

// Delivery lifecycle, separate from OrderStatus (billing) and KotStatus
// (kitchen). Null on non-delivery orders.
enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  DELIVERED
  FAILED
}

model Order {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  orderNumber String // human-readable, sequential per branch per day
  type        OrderType        @default(DINE_IN)
  status      OrderStatus      @default(OPEN)
  channel     OrderChannel     @default(STAFF)
  acceptance  AcceptanceStatus @default(NOT_REQUIRED)

  tableId    String?
  table      Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  guestCount Int?
  // Name typed in by the guest on the QR self-order flow — no account, so
  // this is the only identity captured for that order.
  guestName  String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  subtotal              Decimal @default(0) @db.Decimal(12, 2)
  discountAmount        Decimal @default(0) @db.Decimal(12, 2)
  taxAmount             Decimal @default(0) @db.Decimal(12, 2) // informational breakup only — see ARCHITECTURE.md inclusive-pricing note
  tipAmount             Decimal @default(0) @db.Decimal(12, 2)
  loyaltyPointsRedeemed Int     @default(0)
  loyaltyDiscountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal @default(0) @db.Decimal(12, 2)

  notes         String?
  cancelReason  String?
  cancelledAt   DateTime?
  cancelledById String?
  cancelSource  CancelSource?

  // Who accepted an incoming order and when (acceptance gate only).
  acceptedAt   DateTime?
  acceptedById String?

  // The manual discount as the cashier entered it, kept next to the computed
  // discountAmount so a bill can show both the percentage and the amount.
  discountType  ManualDiscountType?
  discountValue Decimal?            @db.Decimal(12, 2)

  // Client-generated idempotency key for public/unauthenticated order
  // submits (kiosk). A retry after a dropped connection carries the same
  // key and gets the original order back instead of creating a second one.
  clientRequestId String?

  // Delivery (Phase 5). deliveryFee is added on top of the item total at
  // checkout; the zone's fee is snapshotted so later zone edits never
  // rewrite history.
  deliveryZoneId  String?
  deliveryZone    DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  deliveryFee     Decimal         @default(0) @db.Decimal(12, 2)
  deliveryAddress String?
  deliveryPincode String?
  deliveryPhone   String?
  deliveryStatus  DeliveryStatus?
  driverId        String?
  driver          User?           @relation("OrderDriver", fields: [driverId], references: [id], onDelete: SetNull)
  deliveryEtaAt   DateTime?
  deliveredAt     DateTime?
  // Scheduled / pre-order: the kitchen should not start before this time.
  scheduledFor    DateTime?

  // Marketing (Phase 7): what discount source was applied at checkout.
  couponCode    String?
  promotionName String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  billedAt  DateTime?

  items               OrderItem[]
  kots                Kot[]
  payments            Payment[]
  giftCardRedemptions GiftCardRedemption[]
  refunds             Refund[]

  @@unique([branchId, orderNumber])
  @@unique([branchId, clientRequestId])
  @@index([branchId, status])
  @@index([branchId, deliveryStatus])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  // Snapshotted at order time so later menu edits never rewrite history
  // (same discipline as nodedr-pos snapshotting name/taxRate/unit onto InvoiceItem).
  nameSnapshot      String
  unitPriceSnapshot Decimal @db.Decimal(12, 2)
  taxRateSnapshot   Decimal @db.Decimal(5, 2)

  quantity    Int           @default(1)
  lineTotal   Decimal       @db.Decimal(12, 2)
  kitchenNote String?
  status      KotItemStatus @default(NEW)

  modifiers    OrderItemModifier[]
  kotItems     KotItem[]
  stockReturns OrderItemStockReturn[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierId  String
  modifier    Modifier  @relation(fields: [modifierId], references: [id])

  nameSnapshot     String
  priceAdjSnapshot Decimal @db.Decimal(12, 2)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

// ---------------------------------------------------------------------------
// Kitchen Order Tickets
// ---------------------------------------------------------------------------

enum KotStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
  REJECTED // kitchen declined the ticket (CANCELLED = order withdrawn from the floor)
}

enum KotItemStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

model Kot {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stationId String?
  station   KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  ticketNumber   String
  status         KotStatus @default(NEW)
  isPriority     Boolean   @default(false)
  printedCount   Int       @default(0)
  printedAt      DateTime?
  lastPrintError String?

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
  readyAt    DateTime?
  servedAt   DateTime?

  // Who moved the ticket and, for a rejection, when and why.
  acceptedById String?
  rejectedAt   DateTime?
  rejectedById String?
  rejectReason String?

  items KotItem[]

  @@index([orderId])
  @@index([stationId, status])
  @@map("kots")
}

model KotItem {
  id          String    @id @default(cuid())
  kotId       String
  kot         Kot       @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  status KotItemStatus @default(NEW)

  @@index([kotId])
  @@map("kot_items")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  BANK_TRANSFER
  GIFT_CARD
  STORE_CREDIT
  OTHER
}

// ---------------------------------------------------------------------------
// Reservations & Waitlist (Phase 2)
// ---------------------------------------------------------------------------

enum ReservationStatus {
  RESERVED
  CONFIRMED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Reservation {
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  customerName    String
  phone           String?
  email           String?
  guestCount      Int
  reservedAt      DateTime
  durationMinutes Int      @default(90)

  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  specialRequests String?
  deposit         Decimal?          @db.Decimal(12, 2)
  status          ReservationStatus @default(RESERVED)
  channel         OrderChannel      @default(STAFF)
  reminderSentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, reservedAt])
  @@map("reservations")
}

enum WaitlistStatus {
  WAITING
  SEATED
  CANCELLED
}

model WaitlistEntry {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  customerName      String
  phone             String?
  partySize         Int
  quotedWaitMinutes Int?
  notes             String?
  status            WaitlistStatus @default(WAITING)

  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  seatedAt  DateTime?

  @@index([branchId, status])
  @@map("waitlist_entries")
}

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method          PaymentMethod
  amount          Decimal       @db.Decimal(12, 2) // applied to the bill (net of change)
  reference       String? // gateway/UPI txn ref
  // Cash actually handed over and the change given back, when the guest paid
  // more than was applied. Null on older payments and exact payments.
  tendered        Decimal?      @db.Decimal(12, 2)
  changeGiven     Decimal?      @db.Decimal(12, 2)
  createdById     String?
  // Client-generated key for one checkout attempt, so a retried or
  // double-tapped request records its payments once.
  clientRequestId String?
  createdAt       DateTime      @default(now())

  @@unique([orderId, clientRequestId])
  @@index([orderId])
  @@map("payments")
}

model Refund {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount      Decimal       @db.Decimal(12, 2)
  reason      String?
  method      PaymentMethod // how the refund was issued back to the guest
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  stockReturns OrderItemStockReturn[]

  @@index([orderId])
  @@map("refunds")
}

// Which sold units were physically returned (and so put back in stock) with a
// refund. A monetary refund alone never restores stock; rows here are the only
// thing that does, and they cap further returns at the quantity sold.
model OrderItemStockReturn {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  refundId    String
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  quantity    Int
  createdAt   DateTime  @default(now())

  @@index([orderItemId])
  @@index([refundId])
  @@map("order_item_stock_returns")
}

// ---------------------------------------------------------------------------
// Public site: download tracking
// ---------------------------------------------------------------------------

// One row per distribution channel (git-clone, install-script, docker,
// casaos, github, windows-msix, ...) — an aggregate counter, not a
// per-visitor event log. Deliberately stores no IP address, user agent, or
// any other visitor-identifying data: a raw click count needs none of that,
// and not collecting it in the first place is simpler and safer under the
// DPDP Act 2023 than collecting personal data and then having to justify
// retention/consent/erasure for it (see docs/COMPLIANCE-INDIA.md).
model DownloadStat {
  channel String @id
  count   Int    @default(0)

  @@map("download_stats")
}

// Staff clock-in/out (Phase 6). One open row (clockOutAt null) per user at a
// time — enforced in AttendanceService, not the DB, so a forgotten clock-out
// can be closed by a manager rather than blocking the next shift.
model Attendance {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clockInAt  DateTime  @default(now())
  clockOutAt DateTime?
  note       String?

  @@index([branchId, clockInAt])
  @@index([userId, clockOutAt])
  @@map("attendance")
}

// Delivery zone (Phase 5): matched by customer pincode at order time.
model DeliveryZone {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name           String
  fee            Decimal  @default(0) @db.Decimal(12, 2)
  minOrderAmount Decimal  @default(0) @db.Decimal(12, 2)
  etaMinutes     Int      @default(45)
  pincodes       String[]
  isActive       Boolean  @default(true)

  createdAt DateTime @default(now())
  orders    Order[]

  @@index([branchId, isActive])
  @@map("delivery_zones")
}

// Guest "call waiter" / "ask for bill" from the table QR page (Phase 5).
enum TableRequestType {
  WAITER
  BILL
}

model TableRequest {
  id       String @id @default(cuid())
  branchId String
  tableId  String
  table    Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  type       TableRequestType
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@index([branchId, resolvedAt])
  @@index([tableId, type, resolvedAt])
  @@map("table_requests")
}

// ---------------------------------------------------------------------------
// Staff scheduling, leave, payroll (Phase 6)
// ---------------------------------------------------------------------------

model Shift {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startsAt DateTime
  endsAt   DateTime
  note     String?

  @@index([branchId, startsAt])
  @@index([userId, startsAt])
  @@map("shifts")
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)

  type      LeaveType   @default(ANNUAL)
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  reason    String?
  status    LeaveStatus @default(PENDING)

  decidedById String?
  decidedBy   User?     @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([branchId, status])
  @@index([userId, startDate])
  @@map("leave_requests")
}

enum PayType {
  MONTHLY
  HOURLY
}

// One pay profile per staff member. MONTHLY rate is the full-month salary
// (pro-rated by the days in the payroll period); HOURLY is per clocked hour.
model StaffPay {
  userId  String  @id
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  payType PayType @default(MONTHLY)
  rate    Decimal @default(0) @db.Decimal(12, 2)

  @@map("staff_pay")
}

enum PayrollStatus {
  DRAFT
  FINALIZED
}

model PayrollRun {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  periodStart DateTime      @db.Date
  periodEnd   DateTime      @db.Date
  status      PayrollStatus @default(DRAFT)
  tipPool     Decimal       @default(0) @db.Decimal(12, 2)
  totalNet    Decimal       @default(0) @db.Decimal(12, 2)
  createdAt   DateTime      @default(now())
  finalizedAt DateTime?

  lines PayrollLine[]

  @@index([branchId, periodStart])
  @@map("payroll_runs")
}

model PayrollLine {
  id     String     @id @default(cuid())
  runId  String
  run    PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  hoursWorked          Decimal @db.Decimal(8, 2)
  basePay              Decimal @db.Decimal(12, 2)
  tipShare             Decimal @default(0) @db.Decimal(12, 2)
  unpaidLeaveDeduction Decimal @default(0) @db.Decimal(12, 2)
  netPay               Decimal @db.Decimal(12, 2)

  @@unique([runId, userId])
  @@map("payroll_lines")
}

// ---------------------------------------------------------------------------
// Accounting (Phase 6)
// ---------------------------------------------------------------------------

model Expense {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  spentOn      DateTime @db.Date
  category     String
  amount       Decimal  @db.Decimal(12, 2)
  note         String?
  // Paid out of the till: counted against expected cash at day close.
  paidFromCash Boolean  @default(false)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([branchId, spentOn])
  @@map("expenses")
}

// End-of-day cash count. expectedCash = opening float + cash payments taken
// that day - cash expenses recorded that day; variance = counted - expected.
model CashClosing {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  businessDate DateTime @db.Date
  openingFloat Decimal  @default(0) @db.Decimal(12, 2)
  cashSales    Decimal  @db.Decimal(12, 2)
  cashExpenses Decimal  @default(0) @db.Decimal(12, 2)
  expectedCash Decimal  @db.Decimal(12, 2)
  countedCash  Decimal  @db.Decimal(12, 2)
  variance     Decimal  @db.Decimal(12, 2)
  note         String?

  closedById String
  createdAt  DateTime @default(now())

  @@unique([branchId, businessDate])
  @@map("cash_closings")
}

// ---------------------------------------------------------------------------
// Marketing (Phase 7)
// ---------------------------------------------------------------------------

enum DiscountKind {
  PERCENT
  FLAT
}

model Coupon {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  code           String // stored upper-case; unique per branch
  kind           DiscountKind
  value          Decimal      @db.Decimal(12, 2)
  minOrderAmount Decimal      @default(0) @db.Decimal(12, 2)
  maxDiscount    Decimal?     @db.Decimal(12, 2) // cap for PERCENT coupons
  validFrom      DateTime?
  validUntil     DateTime?
  usageLimit     Int?
  usedCount      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([branchId, code])
  @@map("coupons")
}

// Automatic time-window discount (happy hour). Applied at checkout with no
// code; times are minutes since local midnight in the restaurant timezone.
model Promotion {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name        String
  kind        DiscountKind
  value       Decimal      @db.Decimal(12, 2)
  daysOfWeek  Int[] // 0 = Sunday
  startMinute Int
  endMinute   Int
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  @@index([branchId, isActive])
  @@map("promotions")
}

enum CampaignChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum CampaignSegment {
  ALL
  LOYAL
  LAPSED
  BIRTHDAY_MONTH
}

// A saved message + audience. Delivery needs a messaging provider
// (Phase 8 integrations), so for now the audience is exported as a CSV.
model Campaign {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name          String
  channel       CampaignChannel
  segment       CampaignSegment @default(ALL)
  message       String
  createdAt     DateTime        @default(now())
  lastSentAt    DateTime?
  lastSentCount Int?

  @@index([branchId])
  @@map("campaigns")
}

// ---------------------------------------------------------------------------
// Maintenance & documents (Phase 7)
// ---------------------------------------------------------------------------

model Equipment {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name                String
  location            String?
  serviceIntervalDays Int?
  lastServicedAt      DateTime? @db.Date
  nextDueAt           DateTime? @db.Date
  notes               String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())

  logs ServiceLog[]

  @@index([branchId, nextDueAt])
  @@map("equipment")
}

model ServiceLog {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  servicedAt DateTime @db.Date
  cost       Decimal? @db.Decimal(12, 2)
  note       String?
  createdAt  DateTime @default(now())

  @@index([equipmentId, servicedAt])
  @@map("service_logs")
}

enum DocumentCategory {
  SOP
  CONTRACT
  RECIPE
  PURCHASE
  OTHER
}

model Document {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  title     String
  category  DocumentCategory @default(SOP)
  body      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  files DocumentFile[]

  @@index([branchId, category])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Outbound webhooks (Phase 8): signed events to the restaurant's own URLs, so
// payment, accounting, SMS/WhatsApp and delivery-platform tools can be wired
// up through any automation service.
// ---------------------------------------------------------------------------

enum WebhookStatus {
  PENDING
  SUCCESS
  FAILED
}

model WebhookEndpoint {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  url         String
  secret      String // sealed (auth/totp.ts sealSecret); shown in full once
  events      String[] @default([])
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([restaurantId, isActive])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id         String          @id @default(cuid())
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  event          String
  payload        Json
  status         WebhookStatus @default(PENDING)
  attempts       Int           @default(0)
  lastStatusCode Int?
  lastError      String?
  nextAttemptAt  DateTime      @default(now())
  createdAt      DateTime      @default(now())
  deliveredAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------------
// Phase 6/7 completions: budgets, bank reconciliation, branch stock
// transfers, document attachments and scheduled report emails.
// ---------------------------------------------------------------------------

// Monthly spending budget for one expense category (category matches
// Expense.category, case-insensitively, when budget-vs-actual is computed).
model Budget {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  month    String // "YYYY-MM"
  category String
  amount   Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, month, category])
  @@map("budgets")
}

enum BankTxStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

// One line of an imported bank statement. amount is signed: + money in,
// - money out. Outgoing lines are matched against recorded Expenses.
model BankTransaction {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  postedOn    DateTime     @db.Date
  description String
  reference   String       @default("") // "" not null, so the unique key dedupes re-imports
  amount      Decimal      @db.Decimal(12, 2)
  status      BankTxStatus @default(UNMATCHED)
  expenseId   String?
  createdAt   DateTime     @default(now())

  @@unique([branchId, postedOn, description, amount, reference])
  @@index([branchId, postedOn])
  @@map("bank_transactions")
}

// Stock moved between two branches of the same restaurant. Source stock is
// consumed FIFO (type ADJUSTMENT, noted "Transfer out"); the destination gets
// a new batch at the weighted cost of what left the source.
model StockTransfer {
  id             String   @id @default(cuid())
  restaurantId   String
  fromBranchId   String
  toBranchId     String
  fromBranchName String
  toBranchName   String
  ingredientName String
  unit           String
  quantity       Decimal  @db.Decimal(12, 3)
  unitCost       Decimal  @db.Decimal(12, 4)
  note           String?
  createdById    String
  createdAt      DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@map("stock_transfers")
}

// An uploaded file (PDF, image, doc) attached to a Document. Stored in the
// database so backups and restores carry attachments with everything else.
model DocumentFile {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([documentId])
  @@map("document_files")
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

// Emails a report (CSV, XLSX or PDF attached) on a schedule through the
// operator's own SMTP server. Daily = yesterday, weekly = previous 7 days,
// monthly = previous calendar month.
model ReportSchedule {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  reportKey  String
  frequency  ReportFrequency
  format     String          @default("xlsx") // csv | xlsx | pdf
  recipients String[]
  isActive   Boolean         @default(true)
  lastSentAt DateTime?
  lastError  String?
  createdAt  DateTime        @default(now())

  @@index([branchId])
  @@map("report_schedules")
}

// Fedgix customer identities never share staff roles or staff session cookies.
model CustomerAccount {
  id String @id @default(cuid())
  branchId String
  customerId String @unique
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email String
  passwordHash String
  createdAt DateTime @default(now())
  sessions CustomerSession[]
  @@unique([branchId, email])
  @@map("customer_accounts")
}
model CustomerSession {
  id String @id @default(cuid())
  tokenHash String @unique
  accountId String
  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
  @@map("customer_sessions")
}
